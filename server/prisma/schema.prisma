generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String

  // Forgot-password flow. resetTokenHash stores a bcrypt hash of the
  // 6-digit code (never the raw code), so a DB dump alone can't be used to
  // reset an account. resetAttempts caps brute-forcing that code.
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  resetAttempts    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
