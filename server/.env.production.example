NODE_ENV=production

# 4001, not the default 4000 — this VPS already runs the bnhs-character-self-assessment
# backend on port 4000 (PM2 "bnhs-char-assessment-backend", proxied via
# nginx at bnhs-api.synflo.space). nginx routes by hostname to a specific
# local port, so each app on the box still needs its own free port.
PORT=4001

# Postgres running natively on the Oracle VPS (see ../deploy/DEPLOY.md).
# Role/db names follow the same <project>_app / <project> convention as the
# other project sharing this VPS, to keep multiple apps' roles distinguishable.
DATABASE_URL=postgresql://studymate_app:CHANGE_ME@localhost:5432/studymate?schema=public

# Generate a fresh secret for production — never reuse the dev one.
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d

CORS_ORIGIN=*
