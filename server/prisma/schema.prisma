generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String

  // Forgot-password flow. resetTokenHash stores a bcrypt hash of the
  // 6-digit code (never the raw code), so a DB dump alone can't be used to
  // reset an account. resetAttempts caps brute-forcing that code.
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  resetAttempts    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todos            Todo[]
  pomodoroSessions PomodoroSession[]
  quizzes          Quiz[]
  quizAttempts     QuizAttempt[]
  reflections      Reflection[]
  notes            Note[]
}

model Todo {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String   @default("")
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PomodoroSession {
  id              String   @id @default(uuid())
  userId          String
  subject         String   @default("")
  durationSeconds Int
  completedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

model Quiz {
  id          String   @id @default(uuid())
  userId      String
  subject     String
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([userId])
}

model Question {
  id           String   @id @default(uuid())
  quizId       String
  text         String
  options      String[]
  correctIndex Int
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Reflection {
  id           String   @id @default(uuid())
  userId       String
  date         DateTime @default(now())
  subject      String
  learned      String   @default("")
  challenges   String   @default("")
  productivity Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  category  String   @default("General")
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuizAttempt {
  id             String   @id @default(uuid())
  quizId         String
  userId         String
  answers        Int[]
  score          Int
  totalQuestions Int
  percent        Int
  completedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
}
