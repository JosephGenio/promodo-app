NODE_ENV=development
PORT=4000

# Matches server/docker-compose.yml (port 5434 — not Postgres's default 5432,
# in case you already have a native Postgres install using that port)
DATABASE_URL=postgresql://studymate:studymate@localhost:5434/studymate_dev?schema=public

# Generate with: openssl rand -hex 32
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=30d

# Permissive for local dev — the mobile app itself isn't origin-restricted
CORS_ORIGIN=*

# Leave SMTP_HOST blank for local dev — lib/mailer.ts falls back to logging
# the password-reset code to the console instead of sending a real email,
# so the forgot-password flow is fully testable with zero email setup.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<your Brevo account login email>
SMTP_PASS=<SMTP key — Brevo dashboard → Senders, Domains & Dedicated IPs → SMTP & API → SMTP key, NOT your account password>
SMTP_FROM=StudyMate <no-reply@yourdomain.com>

RESET_CODE_EXPIRY_MINUTES=15

# From Google Cloud Console — must match mobile/.env's
# EXPO_PUBLIC_GOOGLE_*_CLIENT_ID values so verifyIdToken() accepts tokens the
# app requests. Leave blank to disable Google Sign-In (POST /api/auth/google
# will 401).
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
