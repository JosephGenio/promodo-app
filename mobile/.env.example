# Copy to .env for local development.
# Android emulator: use 10.0.2.2 to reach your machine's localhost.
# Physical device on the same Wi-Fi: use your machine's LAN IP instead.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# From Google Cloud Console (see README.md "Google Sign-In setup")
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Only needed if you test Google Sign-In via Expo Go on iOS during development.
# The app itself only ships as an Android .apk, so this has no production equivalent.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Dev-only: set to "true" to skip login and preview the main tabs before the
# backend exists. Leave unset/false otherwise.
EXPO_PUBLIC_DEV_SKIP_AUTH=false
