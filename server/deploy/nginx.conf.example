# STALE / UNUSED — kept for reference only.
#
# This assumed nginx would front the API, matching the bnhs sibling
# project's own docs. In reality this VPS reverse-proxies everything
# through a pre-existing Caddy instance running in Docker (shared with an
# n8n install) — nginx was never actually started in production. See
# deploy/DEPLOY.md step 4 and deploy/Caddyfile.example for what's actually
# deployed.
#
# Original intent preserved below in case a future deployment target
# really does use nginx instead of Caddy.

# Reverse proxy for the StudyMate backend API.
# Copy to /etc/nginx/sites-available/studymate-backend, symlink into
# sites-enabled, then run `certbot --nginx -d studymate-api.synflo.space`
# (replace with your actual subdomain) to fill in the SSL directives.
#
# This VPS also hosts the bnhs-character-self-assessment backend on port
# 4000 (bnhs-api.synflo.space) — this app listens on a DIFFERENT port
# (4001, see ../.env.production.example) and a DIFFERENT subdomain so nginx
# can route each hostname to the right local process.

server {
    listen 80;
    server_name studymate-api.synflo.space;

    location / {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
